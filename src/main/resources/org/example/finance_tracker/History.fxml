<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox spacing="30.0" style="-fx-padding: 40;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.finance_tracker.HistoryController">

    <VBox spacing="5.0">
        <Label text="Transaction Ledger" textFill="#1a252f">
            <font><Font name="System Bold" size="32.0" /></font>
        </Label>
        <Label text="Review and export your complete financial history." textFill="#7f8c8d">
            <font><Font size="15.0" /></font>
        </Label>
    </VBox>

    <VBox VBox.vgrow="ALWAYS" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 25, 0, 0, 10);">

        <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ecf0f1;">
            <columns>
                <TableColumn prefWidth="120.0" text="Date">
                    <cellValueFactory><PropertyValueFactory property="date" /></cellValueFactory>
                </TableColumn>

                <TableColumn prefWidth="120.0" text="Type">
                    <cellValueFactory><PropertyValueFactory property="type" /></cellValueFactory>
                </TableColumn>

                <TableColumn prefWidth="150.0" text="Category">
                    <cellValueFactory><PropertyValueFactory property="category" /></cellValueFactory>
                </TableColumn>

                <TableColumn prefWidth="150.0" text="Amount (Ksh)">
                    <cellValueFactory><PropertyValueFactory property="amount" /></cellValueFactory>
                </TableColumn>

                <TableColumn prefWidth="250.0" text="Description">
                    <cellValueFactory><PropertyValueFactory property="description" /></cellValueFactory>
                </TableColumn>
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button onAction="#handleExport" prefHeight="45.0" prefWidth="180.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;" text="Export to CSV" />
        </HBox>

    </VBox>
</VBox>